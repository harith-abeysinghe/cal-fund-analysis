# CAL Fund Analysis Project Configuration
# Copy this file to .env and customize if needed

# CAL Website Configuration
CAL_BASE_URL=https://cal.lk/unittrust/calculator/

# Investment Configuration
MAX_MONTHLY_INVESTMENT_LKR=100000

# Data Directories
DATA_DIR=D:/Personal/CAL Fund Analysis/data
OUTPUT_DIR=D:/Personal/CAL Fund Analysis/output
CACHE_DIR=D:/Personal/CAL Fund Analysis/cache

# Analysis Configuration
MIN_WEEKS_REQUIRED=20

# Target Funds (only these 5 are tracked)
TARGET_FUND_1=Investment Grade Fund
TARGET_FUND_2=CAL Income Fund
TARGET_FUND_3=Quantitative Equity Fund
TARGET_FUND_4=High Yield Fund
TARGET_FUND_5=Capital Alliance Gilt Fund